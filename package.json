{
  "name": "pi-actor-subagents",
  "version": "0.1.0",
  "description": "Run persistent actor-style subagent swarms inside pi.",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "fdietze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdietze/pi-actor-subagents.git"
  },
  "type": "module",
  "files": ["extensions/actor-subagents", "docs/subagents.svg", "docs/publishing.md", "DESIGN.md"],
  "pi": {
    "extensions": ["extensions/actor-subagents/index.ts"]
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint --deny-warnings extensions scripts",
    "test": "find extensions scripts -name '*.test.ts' -print0 | xargs -0 -r node --test",
    "ci": "actionlint -ignore '^unexpected key \"queue\" for \"concurrency\" section\\.' && npm run typecheck && npm run lint && npm run test",
    "publish:ci": "node scripts/publish.ts",
    "demo": "bash scripts/render-demo.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "24.12.4",
    "typebox": "1.3.7"
  }
}
